# Токен GitHub API для живых данных (?live=true). Без него — mock-фикстуры.
GITHUB_TOKEN=
# Базовый URL GitHub REST API.
GITHUB_API_URL=https://api.github.com
# Всегда отдавать mock-фикстуры (true/false).
MOCK_MODE=true
# Возраст в днях, после которого issue/PR считается зависшим.
STALE_DAYS=30
# Хост и порт API.
APP_HOST=0.0.0.0
APP_PORT=8000
# Для живого интеграционного теста: GITHUB_TOKEN + LIVE_GITHUB=1.
LIVE_GITHUB=
